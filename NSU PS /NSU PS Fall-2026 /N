#include<stdio.h>

int main(void)
{
    int T,i ;
    int x , y , z ;
    double half;
    double total_student ;

    scanf("%d" ,&T);

    for (i=0 ; i<T ; i++)
    {
        scanf("%d %d %d" , &x , &y , &z);
        total_student = x*y ;
        half = total_student * 0.5 ;
        if (z>half)
        {
            printf("Yes \n");
        }
        else
        {
            printf("No \n");
        }


    }


    return 0;
}
