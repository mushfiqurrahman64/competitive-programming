#include<stdio.h>





int main(void)
{
    int n;
    int i,j=0;
    int a;


    double positive , negative , zero ;
    double ratio_of_positve , ratio_of_zero , ratio_of_negative;
    positive = negative = zero = 0;

    scanf("%d" ,&n);
    int arr[n];

    for (a=0 ; a<n ; a++)
    {
        scanf("%d" , &arr[a]);
    }


    for(i=0 ; i<n  ; i++)
    {
        if(arr[j]<0)  //negative
        {
            negative = negative + 1;
            j = j+1;
        }
        else if (arr[j] == 0) //Zero
        {
            zero = zero + 1;
            j = j+1;
        }
        else if (arr[j] > 0)  //Positive
        {
            positive = positive + 1;
            j = j+1;
        }


    }

    ratio_of_negative = negative / (double)n ;
    ratio_of_positve = positive / (double)n ;
    ratio_of_zero = zero / (double)n ;

    printf("%.6f \n" , ratio_of_positve);
    printf("%.6f \n" , ratio_of_negative);
    printf("%.6f \n" , ratio_of_zero);





    return 0;
}
