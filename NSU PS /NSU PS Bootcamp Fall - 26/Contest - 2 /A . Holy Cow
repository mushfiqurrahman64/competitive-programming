#include<stdio.h>


int main(void)
{
    int t ;
    scanf("%d" , &t);
    for(int i=0 ; i<t ; i++)
    {
        printf("Case %d: \n" , i+1);
        long long int x1 , x2 , y1 , y2 ;
        long long int x , y ;
        scanf("%lld %lld %lld %lld", &x1 , &y1 , &x2 , &y2);
        int n;
        scanf("%d" , &n);
        for(int i=0 ; i<n ; i++)
        {
            scanf("%lld %lld" , &x , &y);
            if(x1<=x && x<=x2)
            {
                if(y1<=y && y<=y2)
                {
                    printf("Yes \n");
                }
                else
                {
                    printf("No \n");
                }
            }
            else
            {
                printf("No \n");
            }
        }
    }


    return 0;
}
