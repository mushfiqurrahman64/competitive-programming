#include<stdio.h>

int main(void)
{
    int i,n, frnd_1 , frnd_2 , frnd_3 , sum , mark=0;

    scanf("%d" , &n);
    for(i=0 ; i<n ; i++ )
    {
        scanf("%d %d %d" , &frnd_1 , &frnd_2 , &frnd_3);
        sum = frnd_1 + frnd_2 + frnd_3 ;
        if(sum>1)
        {
            mark = mark + 1 ;
        }
        sum = 0;
    }
    printf("%d" , mark);


    return 0;
}
